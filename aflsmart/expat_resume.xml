<?xml version="1.0" encoding="utf-8"?>

<Peach
    xmlns="http://peachfuzzer.com/2012/Peach"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://peachfuzzer.com/2012/Peach /peach/peach.xsd">

    <DataModel name="ExpatResume">

        <Block name="ProcessingInstruction">

            <String
                name="PIOpen"
                value="&lt;?"
                token="true"
                mutable="false"
            />

            <String
                name="PIBody"
                value="xml version=&quot;1.0&quot;"
            />

            <String
                name="PIClose"
                value="?&gt;"
                token="true"
                mutable="false"
            />

        </Block>


        <Block name="Comment">

            <String
                name="CommentOpen"
                value="&lt;!--"
                token="true"
                mutable="false"
            />

            <String
                name="CommentBody"
                value="probe"
            />

            <String
                name="CommentClose"
                value="--&gt;"
                token="true"
                mutable="false"
            />

        </Block>


        <Block name="RootElement">

            <String
                name="ElementOpen"
                value="&lt;"
                token="true"
                mutable="false"
            />

            <String
                name="RootName"
                value="doc"
            />

            <String
                name="NameAttributeSeparator"
                value=" "
                token="true"
                mutable="false"
            />

            <String
                name="Attributes"
                value="a=&quot;1&quot;"
            />

            <String
                name="SelfClose"
                value="/&gt;"
                token="true"
            />

        </Block>


        <String
            name="TrailingWhitespace"
            value=""
        />

    </DataModel>


    <StateModel
        name="TheState"
        initialState="Initial">

        <State name="Initial">

            <Action type="output">

                <DataModel ref="ExpatResume"/>

                <Data fileName="/dev/null"/>

            </Action>

            <Action type="close"/>

        </State>

    </StateModel>


    <Test name="Default">

        <StateModel ref="TheState"/>

        <Publisher class="File">

            <Param
                name="FileName"
                value="repaired"
            />

        </Publisher>

        <Logger class="Filesystem">

            <Param
                name="Path"
                value="logs"
            />

        </Logger>

    </Test>

</Peach>